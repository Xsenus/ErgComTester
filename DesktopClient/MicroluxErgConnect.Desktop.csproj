<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>

    <AssemblyName>MicroluxErgConnect</AssemblyName>
    <RootNamespace>MicroluxErgConnect</RootNamespace>

    <AssemblyVersion>1.0.0.57</AssemblyVersion>
    <FileVersion>1.0.0.57</FileVersion>

    <!-- Платформа/рид -->
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x86</PlatformTarget>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>

    <!-- Отключаем single-file для более компактного exe -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>

    <!-- Языковые ресурсы -->
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>

    <!-- Явно выключаем инвариантную глобализацию -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- Оставляем один ApplicationIcon (убрали дубликат) -->
    <ApplicationIcon>Microlux_Logo_White.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Autoupdater.NET.Official" Version="1.9.2" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <PackageReference Include="QuestPDF" Version="2025.7.3" />
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\microlux-connect.ico" Condition="Exists('Resources\microlux-connect.ico')" />
    <EmbeddedResource Include="Resources\microlux-connect.png" Condition="Exists('Resources\microlux-connect.png')" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/ILog.cs" Link="Logging/ILog.cs" />
    <Compile Include="../Shared/Erg/ErgDataModels.cs" Link="Erg/ErgDataModels.cs" />
    <Compile Include="../Shared/Erg/ErgDataParser.cs" Link="Erg/ErgDataParser.cs" />
    <Compile Include="../Shared/Erg/ErgDataSerializer.cs" Link="Erg/ErgDataSerializer.cs" />
    <Compile Include="../Shared/Erg/ErgReportBuilder.cs" Link="Erg/ErgReportBuilder.cs" />
    <Compile Include="../Shared/Erg/ReportTemplate.cs" Link="Erg/ReportTemplate.cs" />
    <Compile Include="../Shared/Erg/ReportRenderingMode.cs" Link="Erg/ReportRenderingMode.cs" />
    <Compile Include="../Shared/Erg/RenderingSupport.cs" Link="Erg/RenderingSupport.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Microlux_Logo_White.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Views\MainForm_TEST.cs">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>
