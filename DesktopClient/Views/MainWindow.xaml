<Window x:Class="MicroluxErgConnect.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Микролюкс ERG-Connect"
        Width="1100"
        Height="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#221F2E" Padding="16" CornerRadius="12" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="6">
                    <TextBlock Text="Статус подключения" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusText}" FontSize="14" />
                    <WrapPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="16">
                        <StackPanel>
                            <TextBlock Text="Порт" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CurrentPort}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Прибор" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DeviceName}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="ПО" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SoftwareVersion}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Отчет" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ReportName}" />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="{Binding SyncStatus}" FontStyle="Italic" FontSize="12" />
                    <Button Content="Очистить запомненный порт" Width="220" Margin="0,8,0,0" Command="{Binding ForceRescanCommand}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="6" Margin="20,0">
                    <TextBlock Text="Настройки опроса" FontSize="16" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Интервал поиска (с):" VerticalAlignment="Center" />
                        <TextBox Text="{Binding DeviceScanIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Задержка перепроверки (с):" VerticalAlignment="Center" />
                        <TextBox Text="{Binding DeviceReconnectDelaySeconds, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Период синхронизации (мин):" VerticalAlignment="Center" />
                        <TextBox Text="{Binding BackgroundSyncIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Каталог отчетов:" VerticalAlignment="Center" />
                        <Button Content="Открыть" Command="{Binding OpenReportsCommand}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="6">
                    <TextBlock Text="Обновления" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding UpdateStatusText}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Проверить" Command="{Binding CheckUpdatesCommand}" />
                        <Button Content="Установить" Command="{Binding InstallUpdateCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Интервал проверки (мин):" VerticalAlignment="Center" />
                        <TextBox Text="{Binding UpdateCheckIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="URL манифеста:" VerticalAlignment="Center" />
                        <TextBox Text="{Binding UpdateManifestUrl}" Width="260" />
                    </StackPanel>
                    <Button Content="Открыть каталог логов" Command="{Binding OpenLogsCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="0,16,0,16" Background="#221F2E" CornerRadius="12" Padding="12" BorderBrush="#332244" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Журнал" FontSize="18" FontWeight="SemiBold" />
                <ListBox Grid.Row="1" ItemsSource="{Binding Logs}" Margin="0,8,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="4" Margin="0,2" Background="#1A1724" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{Binding Timestamp}" Width="180" />
                                    <TextBlock Text="{Binding Level}" Width="80" />
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Width="720" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <StatusBar Grid.Row="2" Background="#1B1A29" Foreground="{DynamicResource ForegroundBrush}" Height="30">
            <StatusBarItem Content="Микролюкс ERG-Connect" />
            <StatusBarItem Content="Версия: {Binding Source={x:Static Application.Current}, Path=MainWindow.Tag}" />
        </StatusBar>
    </Grid>
</Window>
